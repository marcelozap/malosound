{
  "$schema": "https://openapi.vercel.sh/vercel.json",
  "buildCommand": "python3 tools/build_website.py",
  "outputDirectory": "build",
  "headers": [
    {
      "source": "/assets/audio/:path*",
      "headers": [
        { "key": "Content-Type", "value": "audio/mpeg" },
        { "key": "Content-Disposition", "value": "inline" }
      ]
    }
  ]
}
